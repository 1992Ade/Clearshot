<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TrollStore baseline -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>

	<!-- Launch other apps -->
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<key>com.apple.springboard.opensensitiveurl</key>
	<true/>

	<!-- HID event synthesis (Home key + touches) -->
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.backboard.hid.services</string>
		<string>com.apple.iohideventsystem</string>
		<string>com.apple.frontboard.systemappservices</string>
		<string>com.apple.CARenderServer</string>
		<string>com.apple.replayd</string>
	</array>
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>IOHIDEventServiceUserClient</string>
		<string>IOHIDEventSystemUserClient</string>
		<string>IOSurfaceRootUserClient</string>
	</array>

	<!-- Screen capture (merged from ClearShot) -->
	<key>com.apple.QuartzCore.secure-mode</key>
	<true/>
	<key>com.apple.QuartzCore.screen-access</key>
	<true/>
	<key>com.apple.replayd.allow-screencapture</key>
	<true/>
	<key>com.apple.photos.backup</key>
	<true/>

	<key>get-task-allow</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
</dict>
</plist>
